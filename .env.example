# SMI Invoice Platform - Database Connection Configuration
# DEVELOPMENT ONLY - Never commit actual secrets!
# Use this template to configure local development

# ============================================================================
# Azure SQL Database - Production
# ============================================================================
# Server: shriyamining-sql.database.windows.net
# Database: shriyaminingdb
# Authentication: Azure Entra ID (recommended) or SQL login

DB_PROD_HOST=shriyamining-sql.database.windows.net
DB_PROD_NAME=shriyaminingdb
DB_PROD_USER=your-email@yourdomain.onmicrosoft.com
DB_PROD_PASSWORD=<leave-empty-for-Entra-ID>

# Connection string format (for local testing):
# Server=tcp:shriyamining-sql.database.windows.net;Initial Catalog=shriyaminingdb;Persist Security Info=False;User ID=your-email@yourdomain.onmicrosoft.com;Password=<your-password>;Encrypt=True;Connection Timeout=30;
# Or for SQL login:
# Server=tcp:shriyamining-sql.database.windows.net;Initial Catalog=shriyaminingdb;User ID=sqluser;Password=<your-password>;Encrypt=True;Connection Timeout=30;

# ============================================================================
# Azure SQL Database - Test
# ============================================================================
# Server: shriyamining-sql.database.windows.net
# Database: shriyaminingdbtest
# Authentication: Same as production (or dedicated test user)

DB_TEST_HOST=shriyamining-sql.database.windows.net
DB_TEST_NAME=shriyaminingdbtest
DB_TEST_USER=your-email@yourdomain.onmicrosoft.com
DB_TEST_PASSWORD=<leave-empty-for-Entra-ID>

# Full connection string:
# Server=tcp:shriyamining-sql.database.windows.net;Initial Catalog=shriyaminingdbtest;Persist Security Info=False;User ID=your-email@yourdomain.onmicrosoft.com;Password=<your-password>;Encrypt=True;Connection Timeout=30;

# ============================================================================
# For GitHub Actions (CI/CD Pipeline)
# ============================================================================
# DO NOT add these to this file. Instead:
# 1. Go to GitHub repo > Settings > Secrets and variables > Actions
# 2. Add these as repository secrets (visible in logs will be masked):
#
# Secret Name                    | Value
# ---------------------------------|---------------------------------------------
# DB_CONNECTION_STRING_TEST      | Full connection string to shriyaminingdbtest
# DB_CONNECTION_STRING_PROD      | Full connection string to shriyaminingdb
# AZURE_CREDENTIALS              | Azure service principal JSON (for SWA deployment)
# GITHUB_TOKEN                   | Auto-generated, available in Actions
#
# The CI/CD pipeline will use these secrets safely without exposing them.

# ============================================================================
# Migration Runner Environment
# ============================================================================
# For local development, set these before running migrations:
#
# export DB_CONNECTION_STRING="Server=tcp:shriyamining-sql.database.windows.net;..."
# export DB_USER="your-email@yourdomain.onmicrosoft.com"
# export DB_PASSWORD="your-password"
# export DB_NAME="shriyaminingdbtest"  # For tests
#
# Then run:
#   node database/migration-runner.js --dry-run  (preview)
#   node database/migration-runner.js            (apply)

# ============================================================================
# Azure Entra ID Authentication (Recommended for Production)
# ============================================================================
# Advantages:
# - No passwords stored in GitHub Secrets
# - Automatic credential rotation via managed identity
# - Audit trail in Azure AD
#
# Setup:
# 1. Create Azure AD service principal
# 2. Grant "Contributor" role on SQL server
# 3. Add SQL login: CREATE USER [app-name] FROM EXTERNAL PROVIDER;
# 4. Grant permissions: ALTER ROLE db_datareader ADD MEMBER [app-name];
# 5. In GitHub Actions, use Azure CLI to get access token
# 6. Connection string: "Server=tcp:host;Initial Catalog=db;Authentication=Active Directory Default;"
#
# For local dev: `az login` sets credentials automatically

# ============================================================================
# Testing
# ============================================================================
# Always use shriyaminingdbtest for automated tests
# Never run tests against shriyaminingdb (production)
#
# Pre-deployment checklist:
# [ ] Database migrations run successfully
# [ ] All 77 baseline tests passing (npm run test:all)
# [ ] Error log clean (no unresolved errors)
# [ ] Test database can be reset without data loss (non-production)
