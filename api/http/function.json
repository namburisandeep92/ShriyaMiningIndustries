{
  "scriptFile": "../api/azure-handler.js",
  "entryPoint": "default",
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "route": "{*segments}",
      "methods": ["get", "post", "put", "patch", "delete", "options"]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    }
  ]
}
