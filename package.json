{
  "name": "smi-invoice-platform",
  "version": "1.0.0-alpha",
  "description": "Shriya Mining Industries Invoice Platform - Cloud-native, zero-cost Azure",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:unit": "vitest run tests/unit/ --reporter=verbose",
    "test:api": "vitest run tests/api/ --reporter=verbose",
    "test:output": "vitest run tests/output/ --reporter=verbose",
    "test:db": "vitest run tests/db/ --reporter=verbose",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run tests/a11y/ --reporter=verbose",
    "test:all": "npm run test:unit && npm run test:api && npm run test:output && npm run test:db && npm run test:integration",
    "test:integration": "vitest run tests/api/integration.test.js --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "migrate": "node database/migration-runner.js",
    "migrate:dry-run": "node database/migration-runner.js --dry-run",
    "api:dev": "node api/index.js",
    "api:package": "node scripts/package-api.js",
    "api:test": "vitest run tests/api/integration/ --reporter=verbose",
    "app:dev": "cd app && npm run dev",
    "app:build": "cd app && npm run build",
    "app:type-check": "cd app && npm run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.0",
    "cors": "^2.8.0",
    "uuid": "^9.0.0",
    "mssql": "^9.1.1",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@playwright/test": "^1.40.0",
    "playwright": "^1.40.0",
    "jsdom": "^23.0.0",
    "axe-core": "^4.7.0",
    "axios": "^1.6.0",
    "eslint": "^8.54.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "typescript": "^5.3.0",
    "vue-tsc": "^2.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead"
  ]
}
